# Required for the default model (google:gemini-2.5-flash).
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Optional: DEBUG, INFO, WARNING (default), ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Optional: where to write the log file (default: <repo>/log/weather_assistant.log).
# LOG_FILE=/tmp/weather_assistant.log

# Set these instead if you switch the model string in src/weather_assistant/agent.py.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
