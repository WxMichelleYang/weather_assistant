# Pick a model — provider is the prefix before the colon.
# Default if unset: google:gemini-2.5-flash
MODEL=google:gemini-2.5-flash
# MODEL=openai:gpt-4o
# MODEL=openai:gpt-4o-mini
# MODEL=anthropic:claude-sonnet-4-6

# Set the API key for the provider you chose above.
GOOGLE_API_KEY=your-google-ai-studio-key-here
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
# INFO surfaces per-turn token usage and tool-call invocations.
# Drop to WARNING for a smaller log; bump to DEBUG for HTTP-level traces.
# LOG_LEVEL=DEBUG

# Optional: where to write the log file (default: <repo>/log/weather_assistant.log).
# LOG_FILE=/tmp/weather_assistant.log
